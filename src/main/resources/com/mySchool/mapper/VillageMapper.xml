<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mySchool.mapper.VillageMapper">

    <resultMap id="BaseResultMap" type="com.mySchool.entity.Village">
            <id property="villageId" column="village_id" jdbcType="BIGINT"/>
            <result property="villageName" column="village_name" jdbcType="VARCHAR"/>
            <result property="villageStreet" column="village_street" jdbcType="BIGINT"/>
    </resultMap>

    <select id="findById" resultType="com.mySchool.entity.Village">
        select * from village where village_id = #{id}
    </select>

    <select id="findByVillageName" resultType="com.mySchool.entity.Village">
        select * from village where village_name like CONCAT('%', #{name}, '%')
    </select>

    <select id="findDetailVillage" resultType="com.mySchool.entity.Village">
        select * from village
                          join street on village_street = street_id
                          join district on street_district = district_id
                          join city on district_city = city_id
                          join province on city_province = province_id
        where village_name like CONCAT('%', #{name}, '%')
    </select>


</mapper>
